# Copy this file to .env and fill in values. .env is gitignored.

# ---- Required (always) ----
ANTHROPIC_API_KEY=

# ---- Optional — defaults shown ----
SLIDEATELIER_MODEL=claude-opus-4-7
SLIDEATELIER_OUTPUT_DIR=./output
SLIDEATELIER_TEMPLATES_DIR=./templates

# ---- Production-only ----
# Setting SLIDEATELIER_ENV=production switches on strict env validation.
# When that's set, the vars below MUST also be set or the app refuses to start.
# Leave SLIDEATELIER_ENV unset (or =development) for local dev — defaults apply.
# SLIDEATELIER_ENV=production
# DOMAIN=slideatelier.example.com
# ACME_EMAIL=you@example.com
# SESSION_SECRET=                # `openssl rand -hex 32`

# ---- VPS overlay only (docker-compose.vps.yml) ----
# Caddy fronts Supabase Studio at /studio behind HTTP basicauth. Generate the
# password hash:
#   docker run --rm caddy:2-alpine caddy hash-password --plaintext 'pickapw'
# STUDIO_BASICAUTH_USER=admin
# STUDIO_BASICAUTH_HASH=

# Choose which Caddy config Caddy starts with:
#   /etc/caddy/Caddyfile          → Let's Encrypt; needs DOMAIN + DNS
#   /etc/caddy/Caddyfile.ip-only  → self-signed cert; works without DNS
# CADDY_CONFIG=/etc/caddy/Caddyfile.ip-only
