[Unit]
Description=Hatchik status service (powers status.hatchik.com)
After=network.target

[Service]
Type=simple
WorkingDirectory=/opt/hatchik-status
Environment=HATCHIK_STATUS_DB=/var/lib/hatchik/status.db
Environment=HATCHIK_REGISTRY_FILE=/opt/hatchik-tenants/registry.json
# Set HATCHIK_STATUS_ADMIN_TOKEN to a random secret to enable the
# manual-incident endpoint (POST /api/status/incident). Leave empty
# to disable that admin route entirely.
Environment=HATCHIK_STATUS_ADMIN_TOKEN=
Environment=HATCHIK_STATUS_ALLOWED_ORIGINS=https://status.hatchik.com,https://hatchik.com,https://www.hatchik.com
ExecStart=/opt/hatchik-status/.venv/bin/uvicorn main:app --host 127.0.0.1 --port 8091
Restart=always
RestartSec=5
User=www-data
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
