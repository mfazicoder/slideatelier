[Unit]
Description=Hatchik per-tenant uptime probe + customer alerts
Documentation=file:///opt/hatchik/status-service/tenant_alerts.py
After=network-online.target hatchik-signup.service
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/opt/hatchik/status-service
EnvironmentFile=-/etc/hatchik/status.env
ExecStart=/usr/bin/python3 /opt/hatchik/status-service/tenant_alerts.py
StandardOutput=journal
StandardError=journal
TimeoutStartSec=600
