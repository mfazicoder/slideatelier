# Hatchik Launch Orchestrator — environment template
#
# Copy to .env and fill in real values. Do NOT commit .env.
# systemd reads this file via EnvironmentFile= in the service unit.

# ─── Hetzner Cloud ─────────────────────────────────────────────────────
# Required for --execute. Project-scoped read+write token.
HETZNER_API_TOKEN=
# Pre-uploaded SSH key name; promote.py uses this to bootstrap each VPS.
HETZNER_SSH_KEY_NAME=hatchik-orchestrator

# ─── Cloudflare DNS ────────────────────────────────────────────────────
# Required for --execute when the customer's domain is in our CF account.
# Scoped token: Zone:Read + DNS:Edit on the zones we manage.
CLOUDFLARE_API_TOKEN=

# ─── Resend (transactional email) ──────────────────────────────────────
# Required for customer + founder notifications.
RESEND_API_KEY=

# ─── Hatchik identities ────────────────────────────────────────────────
HATCHIK_FOUNDER_EMAIL=hello@hatchik.com
HATCHIK_FROM_EMAIL=hello@hatchik.com

# ─── Paths (override only if not using systemd defaults) ───────────────
HATCHIK_SIGNUP_DB=/var/lib/hatchik/signups.db
HATCHIK_LAUNCH_REGISTRY=/opt/hatchik-launch-orchestrator/registry.json
HATCHIK_SANDBOX_REGISTRY=/opt/hatchik-orchestrator/registry.json
HATCHIK_LOG_DIR=/var/log/hatchik
