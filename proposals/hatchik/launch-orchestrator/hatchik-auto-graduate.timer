[Unit]
Description=Hatchik auto-graduate daily sweep (Launch → Growth at 15th signup)
Documentation=file:///opt/hatchik/launch-orchestrator/auto_graduate.py

[Timer]
# Once a day at 03:30 UTC — well clear of any nightly backup window
# and well clear of European traffic peaks.
OnCalendar=*-*-* 03:30:00
RandomizedDelaySec=300
Persistent=true
Unit=hatchik-auto-graduate.service

[Install]
WantedBy=timers.target
