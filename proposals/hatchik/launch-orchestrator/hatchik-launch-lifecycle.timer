[Unit]
Description=Daily reconcile for Hatchik Launch tier
Documentation=file:///opt/hatchik-launch-orchestrator/README.md
Requires=hatchik-launch-lifecycle.service

[Timer]
# Daily at 03:00 UTC with up to 10-min jitter (so multiple hosts don't
# all hit Paddle's API at the exact same second).
OnCalendar=*-*-* 03:00:00 UTC
RandomizedDelaySec=10min
Persistent=true
Unit=hatchik-launch-lifecycle.service

[Install]
WantedBy=timers.target
