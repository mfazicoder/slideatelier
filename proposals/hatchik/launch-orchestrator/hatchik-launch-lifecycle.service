[Unit]
Description=Hatchik Launch tier lifecycle reconciler
Documentation=file:///opt/hatchik-launch-orchestrator/README.md
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/opt/hatchik-launch-orchestrator
EnvironmentFile=/opt/hatchik-launch-orchestrator/.env
# Default: SAFE_MODE (no --execute) so the first runs only email summaries.
# When confident, flip to: ExecStart=... launch_lifecycle.py --execute
ExecStart=/usr/bin/python3 /opt/hatchik-launch-orchestrator/launch_lifecycle.py
StandardOutput=journal
StandardError=journal
TimeoutStartSec=15min
# Don't mask failures — a non-zero exit should surface as a unit failure
# so journalctl + systemctl status make it visible.
SuccessExitStatus=0
