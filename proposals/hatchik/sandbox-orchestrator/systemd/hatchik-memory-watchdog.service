[Unit]
Description=Hatchik sandbox memory pressure watchdog
Documentation=file:///opt/hatchik/sandbox-orchestrator/runbooks/memory-overcommit.md
After=multi-user.target

[Service]
Type=oneshot
# memory_watchdog.py is installed to /usr/local/bin/hatchik-memory-watchdog
# (see runbook section 8). It reads /proc/pressure/memory and alerts to
# journald + /var/run/hatchik-memory-pressure when avg10 of "some" > 20.
ExecStart=/usr/local/bin/hatchik-memory-watchdog
# Read-only filesystem except for the marker file location.
ProtectSystem=strict
ReadWritePaths=/var/run /run
ProtectHome=yes
NoNewPrivileges=yes
PrivateTmp=yes
# Watchdog must not itself be OOM-killed before it can warn us.
OOMScoreAdjust=-500
# We don't want a buggy watchdog to spin; one-shot per timer tick.
TimeoutStartSec=30
