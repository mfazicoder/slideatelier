[Unit]
Description=Run Hatchik memory pressure watchdog every 5 minutes
Documentation=file:///opt/hatchik/sandbox-orchestrator/runbooks/memory-overcommit.md

[Timer]
# Fire 2 minutes after boot, then every 5 minutes thereafter.
OnBootSec=2min
OnUnitActiveSec=5min
# Don't synchronise across the fleet — small jitter avoids thundering herd if we
# ever fan this out to more than one host.
RandomizedDelaySec=15s
Unit=hatchik-memory-watchdog.service
AccuracySec=30s
Persistent=false

[Install]
WantedBy=timers.target
