[Unit]
Description=Hatchik 2-hour idle-suspend daemon (loop mode)
Documentation=file:///opt/hatchik-orchestrator/runbooks/idle-suspend.md
After=network.target docker.service
Requires=docker.service

[Service]
Type=simple
WorkingDirectory=/opt/hatchik-orchestrator
EnvironmentFile=-/opt/hatchik-orchestrator/.env
ExecStart=/usr/bin/python3 /opt/hatchik-orchestrator/idle_suspend.py --loop
# `Type=simple` semantics + the flock acquired inside idle_suspend.py
# together give us idempotency: systemd guarantees only one ExecStart is
# active; the lock catches the case where an operator also runs the
# script by hand.
Restart=on-failure
RestartSec=30s
# stdout/stderr → journald; the script ALSO writes structured events to
# /var/log/hatchik/idle-suspend.log
StandardOutput=journal
StandardError=journal
# A run that takes >10 min indicates something is wedged — let the
# watchdog kill it so we don't have a stuck reconciler holding the lock.
TimeoutStartSec=10s
WatchdogSec=600s

# Light hardening — we still need docker.sock access and read of the
# Caddy logs, so we can't run a fully locked-down sandbox.
NoNewPrivileges=true
ProtectSystem=full
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
