[Unit]
Description=Hatchik nightly backup (restic)
Documentation=file:///usr/local/bin/hatchik-backup.sh
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/local/bin/hatchik-backup.sh
StandardOutput=journal
StandardError=journal
TimeoutStartSec=30min
