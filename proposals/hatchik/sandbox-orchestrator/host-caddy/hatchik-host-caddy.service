[Unit]
Description=Hatchik host Caddy — wildcard TLS for *.hatchik.com via Cloudflare DNS-01
Documentation=file:///opt/hatchik-host-caddy/
Wants=network-online.target docker.service
After=network-online.target docker.service
Requires=docker.service

[Service]
# oneshot + RemainAfterExit so systemctl is-active returns 'active' once the
# docker compose stack is up. The compose service itself has
# restart: unless-stopped, so Docker handles container restarts; this unit
# is responsible for boot-time bring-up and explicit operator stop/start.
Type=oneshot
RemainAfterExit=true
WorkingDirectory=/opt/hatchik-host-caddy
EnvironmentFile=/opt/hatchik-host-caddy/.env
ExecStart=/usr/bin/docker compose up -d
ExecStop=/usr/bin/docker compose down
ExecReload=/usr/bin/docker compose restart
TimeoutStartSec=2min
TimeoutStopSec=1min

[Install]
WantedBy=multi-user.target
