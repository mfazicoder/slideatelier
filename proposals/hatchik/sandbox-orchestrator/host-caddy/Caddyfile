# Host Caddy — wildcard TLS + subdomain routing for Hatchik sandboxes.
#
# Tenant routes are MAINTAINED BY provision.py. Each tenant gets its own
# `import` block written to /etc/caddy/tenants.d/<slug>.caddy and the
# `import tenants.d/*` directive pulls them in.
#
# To reload after provision.py writes a new tenant file:
#   docker exec hatchik-caddy caddy reload --config /etc/caddy/Caddyfile

{
    email hello@hatchik.com
    # Use the staging CA while you're testing (no rate limits, untrusted certs)
    # then comment this out and `caddy reload` for real Let's Encrypt certs.
    # acme_ca https://acme-staging-v02.api.letsencrypt.org/directory
}

# ─── Wildcard cert for *.hatchik.com (solved via Cloudflare DNS-01) ──────
# Catch-all that handles any subdomain we haven't explicitly templated.
# Returns a friendly 404 for unknown subdomains.
*.hatchik.com {
    tls {
        dns cloudflare {env.CF_API_TOKEN}
    }
    @unknown {
        not host prepsheet.hatchik.com  # placeholder — provision.py rewrites
    }
    respond @unknown "Sandbox not found. Visit https://hatchik.com to create one." 404
}

# ─── Per-tenant routes — injected here by provision.py ───────────────────
import tenants.d/*.caddy

# ─── Apex (hatchik.com) — marketing site + signup-service (local) ──
# Static marketing files live at /var/www/hatchik on the sandbox host.
# Signup-service runs as hatchik-signup.service on localhost:8090.
hatchik.com, www.hatchik.com {
    tls {
        dns cloudflare {env.CF_API_TOKEN}
    }
    encode gzip zstd

    # Signup + provision API → local FastAPI service
    handle /api/* {
        reverse_proxy localhost:8090
    }

    # Admin metrics dashboard → static page (single file at repo root,
    # deployed as /var/www/hatchik/admin-dashboard.html). Token-gated
    # in the client — the page only renders once a valid X-Admin-Token
    # is pasted and the API endpoints accept it.
    handle /admin/dashboard {
        root * /var/www/hatchik
        rewrite * /admin-dashboard.html
        file_server
    }

    # Everything else → static marketing files
    handle {
        root * /var/www/hatchik
        try_files {path} {path}.html /index.html
        file_server
    }

    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        X-Frame-Options "DENY"
        X-Content-Type-Options "nosniff"
    }
}

# ─── Status page (status.hatchik.com) — self-hosted uptime ──────────────
# Static page lives at /var/www/hatchik/status.html. The status-service
# (hatchik-status.service) probes every component on a 60s loop and
# serves /api/status* from localhost:8091. Wildcard cert above already
# covers this subdomain via Cloudflare DNS-01.
status.hatchik.com {
    tls {
        dns cloudflare {env.CF_API_TOKEN}
    }
    encode gzip zstd

    # Status JSON API → local FastAPI service
    handle /api/* {
        reverse_proxy localhost:8091
    }

    # Everything else → status.html
    handle {
        root * /var/www/hatchik
        rewrite / /status.html
        try_files {path} /status.html
        file_server
    }

    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        X-Frame-Options "DENY"
        X-Content-Type-Options "nosniff"
        # Status page must always reflect live state — never cached.
        Cache-Control "no-store"
    }
}

# ─── Docs (docs.hatchik.com) — static documentation site ────────────────
# Pure static HTML pages live at /var/www/hatchik-docs/ (separate from
# the marketing site at /var/www/hatchik/ to keep deploys independent —
# docs gets updated more often than the marketing pages). Source files
# live in proposals/hatchik/docs/ in the repo and are rsynced over.
# Wildcard cert above already covers this subdomain via Cloudflare DNS-01.
# No API needed — pages are entirely static.
docs.hatchik.com {
    tls {
        dns cloudflare {env.CF_API_TOKEN}
    }
    encode gzip zstd

    # Static files. try_files handles both /foo and /foo.html so links
    # written as href="/getting-started" resolve to getting-started.html
    # without a trailing slash. / falls through to index.html.
    handle {
        root * /var/www/hatchik-docs
        try_files {path} {path}.html /index.html
        file_server
    }

    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        X-Frame-Options "DENY"
        X-Content-Type-Options "nosniff"
        Referrer-Policy "strict-origin-when-cross-origin"
        # Cache static docs for an hour at the edge — they're frequently
        # updated but not minute-by-minute. Long Cache-Control would
        # require a deploy invalidation step we don't have yet.
        Cache-Control "public, max-age=3600"
    }
}
