[Unit]
Description=Hatchik sandbox idle-archive reconciler (one-shot)
After=network.target docker.service
Requires=docker.service

[Service]
Type=oneshot
WorkingDirectory=/opt/hatchik-orchestrator
EnvironmentFile=/opt/hatchik-orchestrator/.env
ExecStart=/usr/bin/python3 /opt/hatchik-orchestrator/lifecycle.py
StandardOutput=journal
StandardError=journal
# Don't restart on failure — the timer fires us again next day.
# A crash here is a bug; let it stay visible in `systemctl status`
# rather than masking it with retries.
TimeoutStartSec=30min

[Install]
WantedBy=multi-user.target
