[Unit]
Description=Hatchik operator agent runtime — one sweep (cohort, AR chase, support triage)
Documentation=file:///opt/hatchik/signup-service/agents/runtime.py
After=network-online.target docker.service hatchik-signup.service
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/opt/hatchik/signup-service
EnvironmentFile=-/etc/hatchik/signup.env
ExecStart=/usr/bin/python3 -m agents.runtime --tick --json
StandardOutput=journal
StandardError=journal
# Agent runs can include multi-second LLM round-trips per ticket; cap the
# whole sweep generously so a stuck call doesn't block the next tick.
TimeoutStartSec=600
