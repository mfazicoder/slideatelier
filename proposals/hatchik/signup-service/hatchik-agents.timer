[Unit]
Description=Hatchik operator agent sweep — every 15 minutes
Documentation=file:///opt/hatchik/signup-service/agents/runtime.py

[Timer]
# Every 15 min — the finest schedule any registered agent uses today
# (support_triage). Daily / weekly agents self-throttle via their
# last-run timestamp inside runtime._is_due, so this cadence is safe.
OnBootSec=5min
OnUnitActiveSec=15min
RandomizedDelaySec=60
Persistent=true
Unit=hatchik-agents.service

[Install]
WantedBy=timers.target
