# Marketing-agent environment.
#
# Copy to `.env` and fill values. In production this file is part of
# the systemd unit's EnvironmentFile (canonical location:
# `/etc/hatchik/marketing.env` on the signup-service host).

# ─── Anthropic ───────────────────────────────────────────────────────────
# Required for every layer. The hello-world smoke test won't run without
# this. On the prod VPS the value lives in /etc/hatchik/signup.env
# alongside the other provider keys; the canonical name there is
# HATCHIK_ANTHROPIC_MASTER_KEY (consumed by signup-service/ai_proxy.py
# too). For local dev, either name works — config.py reads the master
# key first, then falls back to ANTHROPIC_API_KEY.
HATCHIK_ANTHROPIC_MASTER_KEY=
# ANTHROPIC_API_KEY=  # fallback / direct-SDK form

# ─── DB ──────────────────────────────────────────────────────────────────
# Shares the SQLite file with signup-service. On the prod VPS this is
# /var/lib/hatchik/signups.db. For local dev, point it at a scratch path
# you control (the marketing_* tables are added idempotently next to
# signup-service's own tables).
HATCHIK_SIGNUP_DB=./marketing.dev.db

# ─── Cost guard ──────────────────────────────────────────────────────────
# Hard per-tenant daily spend cap. The Anthropic wrapper refuses calls
# once the day's `marketing_agent_runs.cost_usd` rollup exceeds this.
# Defaults to 5.00 if unset.
MARKETING_DAILY_CAP_USD=5.00

# ─── Distribution (later phases — placeholders) ─────────────────────────
# X_API_BEARER_TOKEN=
# RESEND_API_KEY=
# POSTHOG_API_KEY=
# POSTHOG_HOST=https://eu.posthog.com
# NOTION_TOKEN=
# NOTION_DB_STRATEGIES=
