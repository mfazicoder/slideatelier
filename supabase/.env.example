# Self-hosted Supabase env — copy to supabase/.env (gitignored).
#
# Generate the random pieces once and DO NOT commit them anywhere.
#   POSTGRES_PASSWORD       — `openssl rand -hex 24`
#   JWT_SECRET              — `openssl rand -hex 32`  (≥32 char min, used by GoTrue + PostgREST + Realtime + Storage)
#   REALTIME_SECRET_KEY_BASE — `openssl rand -hex 32`
#   REALTIME_DB_ENC_KEY     — exactly 16 bytes (`openssl rand -hex 8`)
#   DASHBOARD_PASSWORD      — `openssl rand -base64 18`
#
# ANON_KEY and SERVICE_ROLE_KEY are JWTs you sign with $JWT_SECRET. Use the
# generator at https://supabase.com/docs/guides/self-hosting/docker#api-keys
# OR run:
#   docker run --rm -e JWT_SECRET=$JWT_SECRET supabase/cli:latest \
#     gen jwt --role anon --exp 31536000
#   docker run --rm -e JWT_SECRET=$JWT_SECRET supabase/cli:latest \
#     gen jwt --role service_role --exp 31536000

############
# Database #
############
POSTGRES_DB=postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace-me-openssl-rand-hex-24

#######
# JWT #
#######
JWT_SECRET=replace-me-openssl-rand-hex-32-min
JWT_EXPIRY=3600
ANON_KEY=replace-me-anon-jwt-signed-with-jwt-secret
SERVICE_ROLE_KEY=replace-me-service-role-jwt-signed-with-jwt-secret

#####################
# GoTrue / Auth     #
#####################
# When DNS lands, set SITE_URL to https://slideatelier.example.com
# and SUPABASE_PUBLIC_URL to https://slideatelier.example.com/supabase
SITE_URL=https://localhost
ADDITIONAL_REDIRECT_URLS=https://localhost
SUPABASE_PUBLIC_URL=https://localhost/supabase
DISABLE_SIGNUP=false
MAILER_AUTOCONFIRM=true

# SMTP — leave blank for v1; auth confirms via MAILER_AUTOCONFIRM=true.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_ADMIN_EMAIL=

############
# Realtime #
############
REALTIME_DB_ENC_KEY=replace-me-16-byte-key-here
REALTIME_SECRET_KEY_BASE=replace-me-openssl-rand-hex-32

###########
# Storage #
###########
FILE_SIZE_LIMIT=52428800   # 50 MB

#########################
# PostgREST schema list #
#########################
PGRST_DB_SCHEMAS=public,storage,graphql_public

##########
# Studio #
##########
STUDIO_DEFAULT_ORGANIZATION=slideAtelier
STUDIO_DEFAULT_PROJECT=default

# Studio is fronted by Caddy at /studio with HTTP basicauth. The Caddy
# basicauth password is SET in the parent project .env (STUDIO_BASICAUTH_*)
# — these values below are for Kong's dashboard plugin, NOT for Caddy.
DASHBOARD_USERNAME=supabase
DASHBOARD_PASSWORD=replace-me-base64-18
